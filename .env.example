# 이 파일에는 실제 API 키를 넣지 마세요. .env로 복사한 뒤 로컬에서만 값을 입력하세요.
OPENAI_API_KEY=sk-proj-...

# 기존 일일 카드뉴스 모델
OPENAI_MODEL=gpt-6-astra

# 경기별 TOP3 뉴스룸 권장 모델
OPENAI_NEWS_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase 서버 전용 값. service role key는 브라우저에 절대 노출하지 마세요.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 선택 사항. 한글 폰트를 직접 지정할 때 사용합니다.
# CARD_NEWS_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
