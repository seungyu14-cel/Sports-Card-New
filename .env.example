# https://openrouter.ai/settings/keys 에서 발급한 키를 입력하세요.
# GitHub 자동화에는 저장소 Settings > Secrets and variables > Actions > Secrets에 등록하세요.
OPENROUTER_API_KEY=sk-or-v1-...

# 선택 사항. 기본값은 config/settings.toml의 model입니다.
OPENROUTER_MODEL=openai/gpt-5.2

# 선택 사항. 한글 폰트를 직접 지정할 때 사용합니다.
# CARD_NEWS_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
